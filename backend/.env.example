# =========================
# CAD Translation Backend
# =========================

DEBUG=true
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Single-tenant admin guard. ON by default and fail-closed.
# ENABLE_ADMIN_GUARD=true  -> sensitive routes require ADMIN_API_TOKEN.
#   If ADMIN_API_TOKEN is left empty while the guard is on, every guarded
#   route returns HTTP 503 rather than opening access (no silent fail-open).
# ENABLE_ADMIN_GUARD=false -> all routes are open to any client that can
#   reach the HTTP port. Use ONLY for a trusted single-user deployment on an
#   isolated network. Not recommended for shared environments.
ENABLE_ADMIN_GUARD=true

# Admin access token for guarded routes. Send it via X-Admin-Token header or
# Authorization: Bearer <token>. Set this when ENABLE_ADMIN_GUARD=true.
# JWT_SECRET_KEY is NOT used as an admin fallback.
ADMIN_API_TOKEN=

DATABASE_URL=sqlite:///./cad_translation.db
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMP_DIR=temp

# -------------------------
# Unified translation engine
# -------------------------
# .env provides the default LLM settings. Runtime JSON settings created by
# `cli-anything-cad config llm init` can override them.
# openai_compatible | openai | openrouter | dashscope | deepseek | groq | minimax | zhipu | moonshot | siliconflow | together | custom
TRANSLATION_PROVIDER=openai_compatible

# For openai_compatible/custom provider
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-max

LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
LLM_BATCH_SIZE=12
LLM_ENABLE_BATCH_JSON=true
LLM_ALLOW_DEMO_FALLBACK=false

# Optional provider-specific keys. When using one, also set
# TRANSLATION_PROVIDER, LLM_BASE_URL, and LLM_MODEL for that same provider.
# Example: TRANSLATION_PROVIDER=minimax with MINIMAX_API_KEY=...
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MINIMAX_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
TOGETHER_API_KEY=

# Legacy Tencent fields (kept for compatibility)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-beijing
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
HUNYUAN_MODEL=hunyuan-lite
HUNYUAN_REGION=ap-beijing
